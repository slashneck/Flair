<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the setup runs on a fresh PC without installing anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FlairSetup</AssemblyName>
    <RootNamespace>FlairSetup</RootNamespace>
    <ApplicationIcon>..\Flair\Assets\flair.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Flair Setup</Product>
    <Description>Flair Setup</Description>
    <Copyright>Copyright (c) 2026 slashneck</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\Flair\Assets\flair.ico" LogicalName="flair.ico" />
    <EmbeddedResource Include="..\Flair\Assets\logo.png" LogicalName="logo.png" />
    <!-- build-release.ps1 passes the packed app in with -p:PayloadZip=... -->
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != ''" />
  </ItemGroup>

</Project>
